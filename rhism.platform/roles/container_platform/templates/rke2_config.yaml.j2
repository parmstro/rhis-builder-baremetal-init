# RKE2 configuration
# Generated by rhism.platform.container_platform
{% if cp_tls_san | length > 0 %}
tls-san:
{% for san in cp_tls_san %}
  - {{ san }}
{% endfor %}
{% endif %}
{% if cp_node_role == 'worker' and cp_server_url | length > 0 %}
server: {{ cp_server_url }}
token: {{ cp_node_token }}
{% endif %}
write-kubeconfig-mode: "0644"
cni: canal
