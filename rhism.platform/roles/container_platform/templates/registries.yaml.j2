# Container registry mirror configuration for k3s/rke2
# Generated by rhism.platform.container_platform
mirrors:
  {{ cp_registry_url.split('/')[0] | default('docker.io') }}:
    endpoint:
      - "https://{{ cp_registry_url }}"
{% if cp_registry_username | length > 0 %}
configs:
  "{{ cp_registry_url.split('/')[0] | default('docker.io') }}":
    auth:
      username: {{ cp_registry_username }}
      password: {{ cp_registry_password }}
{% endif %}
