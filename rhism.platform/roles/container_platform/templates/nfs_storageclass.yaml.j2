# NFS StorageClass
# Generated by rhism.platform.container_platform
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ cp_storage_class_name }}
{% if cp_storage_make_default %}
  annotations:
    storageclass.kubernetes.io/is-default-class: "true"
{% endif %}
provisioner: nfs.csi.k8s.io
parameters:
  server: {{ cp_storage_nfs_server }}
  share: {{ cp_storage_nfs_path }}
reclaimPolicy: Retain
volumeBindingMode: Immediate
mountOptions:
  - hard
  - nfsvers=4.1
