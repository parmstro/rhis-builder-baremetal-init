{# Managed by Ansible — role mail_full. Do not edit by hand. #}
# Postfix virtual alias map — managed by Ansible (mail_full role)
# Do not edit manually; changes will be overwritten.
# Format: alias@domain  target@domain
{% for user in mail_virtual_users | default([]) %}
{% set addr = user.email | default(user.name) | default(user) %}
{% if user.aliases | default([]) | length > 0 %}
{% for alias in user.aliases %}
{{ alias }}    {{ addr }}
{% endfor %}
{% else %}
# {{ addr }} — mailbox delivery via vmailbox map (no aliases defined)
{% endif %}
{% endfor %}
